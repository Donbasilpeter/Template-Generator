{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "frontend-image",
      "essential": true,
      "memory": 512,
      "cpu": 256,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 80
        }
      ],
      "environment": [
        {
          "name": "ENV_FILE",
          "value": "./frontend/.env"
        }
      ],
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "START"
        }
      ]
    },
    {
      "name": "backend",
      "image": "backend-image",
      "essential": true,
      "memory": 512,
      "cpu": 256,
      "portMappings": [
        {
          "hostPort": 8000,
          "containerPort": 8000
        }
      ],
      "environment": [
        {
          "name": "ENV_FILE",
          "value": "./back-end/.env"
        }
      ]
    }
  ]
}
